SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD_HASH=   # npm run hash-password -- '비밀번호' 출력값
SESSION_SECRET=        # openssl rand -hex 32

# ── 메일 발송 (Resend) ───────────────────────────────────────────
RESEND_API_KEY=        # resend.com → API Keys → Sending access 권한으로 발급
MAIL_FROM=onboarding@resend.dev
                       # 도메인 인증 전 샌드박스 발신 주소. 도메인이 생기면 '이름 <noreply@도메인>'으로 교체
MAIL_TO_OVERRIDE=      # 설정하면 모든 수신자를 이 주소로 돌린다(개발·스테이징 보호).
                       # 샌드박스는 Resend 가입 이메일로만 발송되므로 그 주소를 넣을 것. 운영에서는 비운다.
APP_URL=               # 메일에 넣는 절대 URL(예: https://survey.example.kr). 설정하면 Host 헤더에
                       # 의존하지 않는다 — 비워두면 요청의 Host 헤더로 만든 origin을 그대로 쓰므로
                       # 위조된 Host가 관리자 알림 메일 링크에 실릴 수 있다(app/api/apply/README.md 참고).
ADMIN_NOTIFY_EMAIL=    # 교사가 /apply로 신청하면 알림을 받을 관리자 주소. 비워두면 알림 메일을
                       # 아예 시도하지 않는다(신청 접수 자체는 그래도 성공한다).
